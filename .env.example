# Author: Vishal Bulbule
# Date: 2026-09-22

# Copy to .env and fill in the values you need. .env is ignored by git.
# adk web / adk run load the nearest .env, walking up from the agent folder,
# so this one file covers every agent in the repository.

# --- Gemini: choose one option ---

# Option A: Gemini API key from https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
GOOGLE_API_KEY=your-api-key

# Option B: Agent Platform (formerly Vertex AI).
# Run `gcloud auth application-default login` first.
# gemini-3.5-flash is served from the global location.
# GOOGLE_GENAI_USE_ENTERPRISE=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# --- Only needed by some modules ---

# Modules 4 and 6: GitHub triage samples (read-only token is enough)
GITHUB_PERSONAL_ACCESS_TOKEN=

# Module 6: Google Maps MCP sample
GOOGLE_MAPS_API_KEY=

# Module 3: LiteLLM sample that calls Claude
ANTHROPIC_API_KEY=
