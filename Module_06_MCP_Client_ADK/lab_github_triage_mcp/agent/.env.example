# Option A: Gemini API key from https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
GOOGLE_API_KEY=your-api-key

# Option B: Agent Platform (formerly Vertex AI). Run `gcloud auth application-default login` first.
# GOOGLE_GENAI_USE_ENTERPRISE=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# Fine-grained GitHub token with read-only access to issues on the repos you triage.
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_your-token
