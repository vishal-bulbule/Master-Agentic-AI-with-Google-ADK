# Date: 2026-09-22

# Option A: Gemini API key from https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
GOOGLE_API_KEY=your-api-key
# Live model ID on the Gemini API (AI Studio).
LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Option B: Agent Platform (formerly Vertex AI). Run `gcloud auth application-default login` first.
# Live models are not served from the global location; use a region such as us-central1.
# GOOGLE_GENAI_USE_ENTERPRISE=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# Live model ID on Agent Platform (also the default when LIVE_MODEL is unset).
# LIVE_MODEL=gemini-live-2.5-flash-native-audio
