# Date: 2026-09-22

# VertexAiSearchTool needs Agent Platform (formerly Vertex AI); a Gemini API key does not work.
# Run `gcloud auth application-default login` first.
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# Full resource name of your Vertex AI Search data store (see the README).
VERTEX_AI_SEARCH_DATASTORE_ID=projects/your-project-id/locations/global/collections/default_collection/dataStores/your-datastore-id
